# The deploy tools' pinned versions (hosting slice 5): the one place they're
# set. The setup action (.github/actions/setup) adds these to every job's
# environment, and steps run them as `pnpm dlx "$VERCEL_CLI" …`. They're
# tools, not repo dependencies. Exact versions only (a unit test checks).
VERCEL_CLI=vercel@65.16.0
POWERSYNC_CLI=powersync@0.10.3
