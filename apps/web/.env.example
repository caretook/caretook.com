# Server-only. DATABASE_URL comes from packages/data/.env.

# 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The origin that serves /api/auth (the dev server, in dev).
BETTER_AUTH_URL="http://localhost:5173"
# Extra origins allowed to call /api/auth, comma-separated. Capacitor's are built in.
AUTH_TRUSTED_ORIGINS=""

# Public (bundled into client code). Where the native app finds the API.
# Leave empty on the web: it calls its own origin.
VITE_API_ORIGIN=""

# The PowerSync service (docker-compose locally, the instance URL on PowerSync
# Cloud). Server: the audience of the JWTs Better Auth signs for it.
POWERSYNC_URL="http://localhost:8080"
# Public: where clients connect to PowerSync. The same URL.
VITE_POWERSYNC_URL="http://localhost:8080"

# The origin every emailed link (and the marketing site's canonical URL) is
# built from; never the request's Host header. Loop worktrees get their own port.
APP_URL="http://localhost:5173"

# Email (@caretook/notifications). MAIL_SENDER: log (the default outside
# production: stored in dev_mail, read at /dev/mail), memory (tests) or resend
# (production, which refuses anything else and needs RESEND_API_KEY).
MAIL_SENDER="log"
RESEND_API_KEY=""
# A subdomain address, with SPF, DKIM and DMARC set up for it.
MAIL_FROM="Caretook <no-reply@mail.caretook.com>"
# Outside production, Resend mails only these: comma-separated addresses or @domains.
MAIL_ALLOWLIST=""
# Where the marketing site's contact messages are emailed (the team's support
# inbox). Required in production; outside it the default is support@example.com.
SUPPORT_EMAIL="support@example.com"
# The bearer token for /api/cron/outbox (the outbox sweep): openssl rand -base64 32
CRON_SECRET=""
# Encrypts invite-link tokens at rest, so owners can copy an active link again:
# openssl rand -base64 32. Required in production; dev, tests and local check
# builds fall back to a fixed dev key. If you set it, set the same value in
# packages/data/.env, or the seeded link can't be copied.
INVITE_LINK_KEY=""

# Hosting (hosting slice 1). Leave these empty in dev, tests and check builds.
# The deploy target: staging or production (both run with NODE_ENV=production).
# Set, the server checks its environment on its first request and answers 503
# until it's complete (`pnpm deploy:env <target>` runs the same check), and
# staging is noindex everywhere and mails only MAIL_ALLOWLIST. Builds read it
# too (prerendered pages are files), so each environment builds itself.
APP_ENV=""
# Verifies Resend's bounce and complaint webhooks (Svix): whsec_…, from Resend.
RESEND_WEBHOOK_SECRET=""
# The migrations role's direct (unpooled) URL: DDL rights. Only the deploy
# Action holds it (GitHub environment secrets); never set it on the server.
MIGRATIONS_DATABASE_URL=""
