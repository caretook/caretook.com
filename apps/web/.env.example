# Server-only. DATABASE_URL comes from packages/data/.env.

# 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The origin that serves /api/auth (the dev server, in dev).
BETTER_AUTH_URL="http://localhost:5173"
# Extra origins allowed to call /api/auth, comma-separated. Capacitor's are built in.
AUTH_TRUSTED_ORIGINS=""

# Public (bundled into client code). Where the native app finds the API.
# Leave empty on the web: it calls its own origin.
VITE_API_ORIGIN=""

# The PowerSync service (docker-compose locally, the instance URL on PowerSync
# Cloud). Server: the audience of the JWTs Better Auth signs for it.
POWERSYNC_URL="http://localhost:8080"
# Public: where clients connect to PowerSync. The same URL.
VITE_POWERSYNC_URL="http://localhost:8080"

# The origin every emailed link (and the marketing site's canonical URL) is
# built from; never the request's Host header. Loop worktrees get their own port.
APP_URL="http://localhost:5173"

# Email (@caretook/notifications). MAIL_SENDER: log (the default outside
# production: stored in dev_mail, read at /dev/mail), memory (tests) or resend
# (production, which refuses anything else and needs RESEND_API_KEY).
MAIL_SENDER="log"
RESEND_API_KEY=""
# A subdomain address, with SPF, DKIM and DMARC set up for it.
MAIL_FROM="Caretook <no-reply@mail.caretook.com>"
# Outside production, Resend mails only these: comma-separated addresses or @domains.
MAIL_ALLOWLIST=""
# The bearer token for /api/cron/outbox (the outbox sweep): openssl rand -base64 32
CRON_SECRET=""
# Encrypts link-invite tokens at rest (invites slice 4): openssl rand -base64 32
INVITE_LINK_KEY=""
