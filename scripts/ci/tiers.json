{
  "tiers": ["static", "unit", "integration", "components", "full", "candidate", "release"],
  "jobs": {
    "static": ["static"],
    "unit": ["unit"],
    "integration": ["integration"],
    "components": ["components-1", "components-2", "components-3"],
    "full": ["build"],
    "candidate": ["browser"],
    "release": ["browser-2", "browser-3", "zone-components-1", "zone-components-2", "zone-browser"]
  },
  "fileGroups": [
    { "group": "browser", "pattern": "scripts/browser-checks/*.spec.mjs", "tier": "candidate" },
    { "group": "browser-tooling", "pattern": "scripts/loops/browser.test.mjs", "tier": "integration" },
    { "group": "integration", "pattern": "*.int.test.ts", "tier": "integration" },
    { "group": "components", "pattern": "*.browser.test.tsx", "tier": "components" },
    { "group": "unit", "pattern": "*", "tier": "unit" }
  ],
  "narrowedTiers": ["unit", "integration", "components"],
  "browserCheck": "scripts/browser-checks/*.spec.mjs",
  "narrowedFile": ".ci-narrowed.json",
  "forcedFlakeFile": ".github/ci-force-flake.json",
  "refPrefix": "ci/"
}
