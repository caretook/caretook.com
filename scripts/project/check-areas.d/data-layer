# check-areas: the data layer. Services, models, permissions and errors have
# integration tests; the area files name the schemas and seeds screens read,
# and the services and models a check reaches (the upload switch's are
# roundtrip's sync matrix). The rest (calendars, search, …) map to none here.
packages/data/src/                       -
packages/data/scripts/                   -
packages/data/src/db/schema/core/timeZone.ts  roundtrip
# Seeds: the screens that read them.
packages/data/src/db/seeds/              app-shell
# The seed guard (hosting slice 1): unit and integration tests.
packages/data/src/db/seeds/guard.ts      -
# A schema folder's index re-exports its tables: no check of its own.
packages/data/src/db/schema/*/index.ts   -
# So does a domain folder's index.
packages/data/src/domain/*/index.ts      -
