apps/web/app/lib/firstSync.ts            first-sync
apps/web/app/lib/auth-client.ts          sign-in signout-wipe
apps/web/app/lib/sync/client.ts          sign-in first-sync signout-wipe
apps/web/app/lib/sync/index.ts           first-sync roundtrip live-notes
apps/web/app/lib/sync/schema.ts          roundtrip live-notes providers phase2
packages/auth/src/*                      sign-in first-sync signout-wipe
apps/web/app/components/shell/*          first-sync

