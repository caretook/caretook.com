# check-areas: the /app frame, menus, theme, the group route, routes and
# URLs, account and group settings. The frame's screen (header, menus, theme
# choice, last group, tab bar, section links) is component tests
# (layout/frame.browser.test.tsx); app-shell.mjs keeps the flows: the theme
# before first paint, sign-out from the menu, a rename and members across
# devices. The layout route runs the session check on every /app navigation.
# Its header's magnifier is component tests (search/search.browser.test.tsx).
apps/web/app/routes/app/layout/route.tsx sign-in session-end
apps/web/app/routes/app/layout/UserMenu.tsx app-shell
apps/web/app/routes/app/layout/*         -
apps/web/app/routes/app/home/*           first-sync
apps/web/app/components/shell/*          first-sync
# Native / redirects to /app (native build only; no rule had it).
apps/web/app/routes/native-index.tsx     sign-in phase2 roundtrip

# Routes, URLs, the group route and settings subpages: component tests
# (groupRoute, timelineSheetUrls and settingsFrame browser tests); first-sync
# keeps a deep link after a full load and the group route's syncing state,
# layout-offline the sheets opening offline. lib/groupContext.ts has its unit test.
apps/web/app/routes.ts                   first-sync layout-offline
apps/web/app/routes/app/groups/layout/*  app-shell first-sync
apps/web/app/routes/app/groups/index/*   -
apps/web/app/lib/group.tsx               first-sync
apps/web/app/lib/groupSections.ts        -

# Account settings, and group settings and members.
apps/web/app/routes/app/settings/*       layout-offline
apps/web/app/lib/me.ts                   layout-offline
apps/web/app/components/settings/*       -
packages/data/src/db/schema/userPreferences.ts layout-offline
apps/web/app/routes/app/groups/settings/members/* app-shell invites profiles-contacts
apps/web/app/routes/app/groups/settings/* app-shell
