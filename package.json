{
  "name": "caretook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @caretook/web dev",
    "build": "pnpm -r build",
    "build:native": "pnpm --filter @caretook/web build:native",
    "typecheck": "pnpm -r typecheck",
    "typegen": "pnpm --filter @caretook/web typegen",
    "lint": "pnpm typegen && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=6144\" eslint .",
    "lint:fix": "pnpm typegen && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=6144\" eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project '!tooling:browser' --project '!project:tooling'",
    "test:tooling": "node node_modules/risa/loops/tooling-lint.mjs && node node_modules/risa/loops/tooling-tests.mjs",
    "test:project": "vitest run --project project:unit --project project:tooling",
    "test:browser-harness": "vitest run --project tooling:browser",
    "test:watch": "vitest",
    "test:unit": "vitest run --project data:unit",
    "test:integration": "vitest run --project integration",
    "test:components": "vitest run --project web:components",
    "test:components:install": "playwright install chromium",
    "build:budget": "node scripts/build/check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:budget",
    "hooks:install": "git config core.hooksPath .githooks",
    "log": "bash scripts/project/log.sh",
    "deploy:env": "node scripts/deploy/env.mjs",
    "datastore:start": "pnpm datastore:up && pnpm datastore:migrate && pnpm datastore:seed",
    "datastore:up": "docker compose up -d --wait",
    "datastore:stop": "docker compose down",
    "datastore:logs": "docker compose logs -f",
    "datastore:generate": "pnpm --filter @caretook/data datastore:generate",
    "datastore:migrate": "pnpm --filter @caretook/data datastore:migrate",
    "datastore:seed": "pnpm --filter @caretook/data datastore:seed",
    "datastore:clear": "pnpm --filter @caretook/data datastore:clear",
    "datastore:reset": "pnpm datastore:clear && pnpm datastore:migrate && pnpm datastore:seed && pnpm datastore:powersync",
    "datastore:reset:staging": "pnpm --filter @caretook/data datastore:reset:staging",
    "datastore:powersync": "pnpm --filter @caretook/data datastore:powersync",
    "datastore:studio": "pnpm --filter @caretook/data datastore:studio",
    "admin:grant": "pnpm --filter @caretook/data admin:grant",
    "db:roles": "pnpm --filter @caretook/data db:roles",
    "db:access": "pnpm --filter @caretook/data db:access",
    "auth:rotate-jwks": "pnpm --filter @caretook/data auth:rotate-jwks",
    "calendar:google-smoke": "pnpm --filter @caretook/data calendar:google-smoke",
    "datastore:start:test": "pnpm datastore:up:test && NODE_ENV=test pnpm datastore:migrate",
    "datastore:up:test": "docker compose -f docker-compose.test.yml up -d --wait",
    "datastore:stop:test": "docker compose -f docker-compose.test.yml down",
    "datastore:reset:test": "NODE_ENV=test pnpm datastore:clear && NODE_ENV=test pnpm datastore:migrate",
    "deploy:smoke": "node scripts/deploy/smoke.mjs",
    "docs:budget": "node scripts/project/doc-budget.mjs warn || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "risa": "github:interrobangc/risa#730639ee063ccd35812a22a75d2d2b47b87c2522",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
