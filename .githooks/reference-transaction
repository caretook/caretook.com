#!/usr/bin/env bash
# Guards local main and staging against being moved (commit, merge, reset,
# branch -f, rebase), except a fast-forward to the remote's copy, which is what
# `git pull` does after a PR merge. Deletes are allowed: local main and staging
# are mirrors of GitHub, and git's own ref packing looks exactly like a delete.
# shellcheck source=protect.sh
source "$(dirname "$0")/protect.sh"
state=$1
input=$(cat)
[[ $state == prepared ]] || exit 0
while read -r _old new ref; do
  [[ $ref == refs/heads/* ]] || continue
  b=${ref#refs/heads/}
  [[ $b =~ $PROTECTED_RE ]] || continue
  [[ $new =~ ^0+$ ]] && continue # a delete, or pack-refs pruning a loose ref
  [[ $new == "$(git rev-parse --verify --quiet "$ref" || true)" ]] && continue # unchanged (pack-refs)
  [[ $new == "$(git rev-parse --verify --quiet "refs/remotes/origin/$b" || true)" ]] && continue # a pull
  overridden "update of $b to ${new:0:9}" || refuse "updating $b (to ${new:0:9}) locally"
done <<< "$input"
exit 0
