DATABASE_URL="postgresql://caretook:password@localhost:5434/caretook"
# Keep small on serverless (each function instance gets its own pool).
DATABASE_MAX_POOL="10"
# How long a query waits for a new connection (ms; default 2000). The
# integration tests use 10000 (packages/data/test/env.ts).
# DATABASE_CONNECT_TIMEOUT_MS="2000"
# Log every SQL statement.
DB_DEBUG="false"
# Password for every seeded @example.com account (dev only).
SEED_USER_PASSWORD="caretook-dev-password"

# Hosting (hosting slice 1). Leave these empty in dev and tests.
# The deploy target: staging or production. The seed refuses production, and a
# non-localhost database unless this is staging (which needs a secret
# SEED_USER_PASSWORD, never the dev default above).
APP_ENV=""
# Verifies Resend's bounce and complaint webhooks (Svix): whsec_…, from Resend.
RESEND_WEBHOOK_SECRET=""
# The migrations role's direct (unpooled) URL: DDL rights, for migrations and
# the roles script. Only the deploy Action holds it (GitHub environment secrets).
MIGRATIONS_DATABASE_URL=""
